    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Azure Speech resource",
        "fr": "Votre ressource Azure Speech"
      },
      "description": {
        "en": "Azure Speech is billed to your own Azure subscription, per character spoken; the free tier (F0) gives 500,000 characters of neural voices a month. Create a Speech resource in the Azure portal, then copy one of its keys and its region (Keys and Endpoint page).",
        "fr": "Azure Speech est facturé sur votre propre abonnement Azure, au caractère prononcé ; le palier gratuit (F0) donne 500 000 caractères de voix neuronales par mois. Créez une ressource Speech dans le portail Azure, puis copiez l’une de ses clés et sa région (page Clés et point de terminaison)."
      },
      "links": [
        {
          "url": "https://azure.microsoft.com/pricing/details/cognitive-services/speech-services/",
          "label": {
            "en": "Azure Speech prices",
            "fr": "Tarifs d’Azure Speech"
          }
        },
        {
          "url": "https://learn.microsoft.com/azure/ai-services/speech-service/language-support?tabs=tts",
          "label": {
            "en": "Azure voices",
            "fr": "Voix d’Azure"
          }
        }
      ]
    },
    {
      "key": "speech_key",
      "type": "secret",
      "label": {
        "en": "Resource key",
        "fr": "Clé de la ressource"
      },
      "description": {
        "en": "KEY 1 or KEY 2 of the Speech resource. Kept by Gladys in its database, never shown again, sent only to Azure Speech.",
        "fr": "KEY 1 ou KEY 2 de la ressource Speech. Gardée par Gladys dans sa base, jamais réaffichée, envoyée seulement à Azure Speech."
      },
      "required": true
    },
