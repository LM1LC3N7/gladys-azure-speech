  "type": "tts",
  "name": "Azure Speech",
  "description": {
    "en": "Microsoft Azure Speech neural voices for Gladys announcements, with your own key.",
    "fr": "Voix neuronales Microsoft Azure Speech pour les annonces de Gladys, avec votre propre clé."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-azure-speech:0.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-azure-speech/main/cover.png",
